venv/
__pycache__/
*.pyc
.env

# Ignore everything in data by default
data/*
!data/.keep
!data/eval_questions.json

# Raw PDFs are stored locally or in object store
!data/raw_pdfs/
data/raw_pdfs/*
!data/raw_pdfs/.keep

# Ignore chroma database files (too large for GitHub)
data/chroma_db/

models/*
!models/.keep
.pytest_cache/
.chroma/
logs/*
!logs/.keep

# Tool caches
.mypy_cache/
.ruff_cache/

# Archive files (should never be committed — too large)
*.zip
*.7z
*.tar.gz
*.gz
