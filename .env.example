# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# LLM — OpenRouter (recommended — free tier)
# https://openrouter.ai/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
LLM_MAX_RETRIES=3

# API security (optional for local dev; recommended for deployed API)
API_KEY=
API_RATE_LIMIT_PER_MINUTE=60

# Paths
CHROMA_PERSIST_DIR=data/chroma_db
RAW_PDF_DIR=data/raw_pdfs

# Embeddings & chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# Retrieval distance above this flags a low-confidence answer
LOW_CONFIDENCE_DISTANCE=0.85

# Hybrid search (BM25 + dense, fused with Reciprocal Rank Fusion)
ENABLE_HYBRID_SEARCH=true
# RRF balance: 0.5 = equal dense and sparse
HYBRID_ALPHA=0.5

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional — Portkey AI gateway (leave empty if unused)
PORTKEY_API_KEY=
PORTKEY_GATEWAY_URL=https://api.portkey.ai/v1
