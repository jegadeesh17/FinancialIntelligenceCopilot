# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# Every variable maps to a field in configs/settings.py. Commented-out lines show the code default.

# --- LLM (OpenRouter) ---

# OpenRouter API key. Required for live answers; create one at https://openrouter.ai/keys.
# Empty is treated as missing (src/generator.py).
OPENROUTER_API_KEY=

# Model slug sent to OpenRouter.
# OPENROUTER_MODEL=openrouter/free

# Comma-separated model slugs tried, in order, after OPENROUTER_MODEL fails. Empty means no fallback models.
# OPENROUTER_FALLBACK_MODELS=

# Attempts per model before moving to the next one (1 to 5).
# LLM_MAX_RETRIES=3

# --- API security ---

# If set, POST /ask requires the header "x-api-key: <this value>". Leave empty for an open API.
API_KEY=

# Max POST /ask requests per client IP per rolling 60 seconds (in memory, per instance).
# API_RATE_LIMIT_PER_MINUTE=60

# --- Paths ---

# Where ChromaDB persists the index (relative paths resolve from the project root).
# CHROMA_PERSIST_DIR=data/chroma_db

# Directory scanned for source PDFs.
# RAW_PDF_DIR=data/raw_pdfs

# --- Embeddings, chunking and retrieval ---

# Sentence-Transformers model used for chunk and query embeddings (CPU).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunk size and overlap in characters (CHUNK_OVERLAP must be smaller than CHUNK_SIZE). Changing them needs an index rebuild.
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100

# Number of chunks returned to the generator (1 to 20).
# TOP_K=5

# Best retrieval distance above this value sets low_confidence=true on the answer.
# LOW_CONFIDENCE_DISTANCE=0.85

# Default for the "hybrid" field of POST /ask: BM25 re-ranks the dense candidates with Reciprocal Rank Fusion.
# ENABLE_HYBRID_SEARCH=true

# --- Defined in settings but not read by the current code ---

# Defined in settings but not read by the current code. The fusion weight is hard-coded to 0.5 in src/retriever.py.
# HYBRID_ALPHA=0.5

# Defined in settings but not read by the current code. The generator always calls OpenRouter.
# LLM_PROVIDER=openrouter

# Defined in settings but not read by the current code.
# ENVIRONMENT=development

# Defined in settings but not read by the current code.
# LOG_LEVEL=INFO

# Defined in settings but not read by the current code (no Portkey gateway is wired in).
PORTKEY_API_KEY=

# Defined in settings but not read by the current code.
# PORTKEY_GATEWAY_URL=https://api.portkey.ai/v1
